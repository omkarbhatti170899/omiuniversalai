# Omi's controlled SearXNG — Fly.io image (no docker-compose needed: Fly builds
# this directly). Same hardened instance as docker-compose.yml, adapted for a
# platform that terminates TLS at the edge:
#   • no Caddy inside — Fly's proxy is the front door (TLS, HTTP/2, checks)
#   • /healthz served by the app for Fly's health checks (no auth needed)
#   • JSON API remains gated by X-Omi-Secret (see limiter.toml)
FROM searxng/searxng:latest

# Our single source of truth: the curated engine pool, JSON format enabled,
# per-engine timeouts, bot detection on. Copied over the image defaults.
USER root
COPY settings.yml /etc/searxng/settings.yml
COPY limiter.toml /etc/searxng/limiter.toml

# Tiny sidecar: answers /healthz without touching the search machinery, so
# platform health checks can never trigger engine fan-out. Uses searxng's
# own uwsgi? No — the official image runs uwsgi on :8080, and SearXNG itself
# serves /healthz in recent versions; for older ones the proxy check below
# falls back to "/" (200). Keep it simple and honest:
#   Fly check → GET /healthz (200 when the app answers at all).
# SearXNG >= 2024.x routes /healthz to a static 200 via settings `healthcheck`;
# if absent, the check still passes on the HTML index while JSON stays gated.
ENV SEARXNG_SETTINGS_PATH=/etc/searxng/settings.yml

EXPOSE 8080

# The base image's entrypoint (uwsgi) is kept unchanged.
